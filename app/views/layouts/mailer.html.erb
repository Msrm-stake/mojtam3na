<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= text_direction %>">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <body style="margin:0;padding:24px 12px;background:#FBF7EE;font-family:Nunito,Cairo,Helvetica,Arial,sans-serif;color:#1F2A27;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;">
            <tr>
              <td style="background:#0B5D4B;color:#FBF7EE;padding:18px 28px;font-size:20px;font-weight:800;"><%= t("shared.navbar.brand") %></td>
            </tr>
            <tr>
              <td style="padding:28px;"><%= yield %></td>
            </tr>
          </table>
          <p style="max-width:560px;margin:16px 0 0;font-size:12px;line-height:1.5;color:#4F5E59;"><%= t("mailers.footer") %></p>
        </td>
      </tr>
    </table>
  </body>
</html>
