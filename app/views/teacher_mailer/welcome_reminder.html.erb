<div dir="<%= I18n.locale.to_s == "ar" ? "rtl" : "ltr" %>">
  <h1 style="font-size:22px;line-height:1.3;color:#0B5D4B;margin:0 0 12px;"><%= t(".heading", name: @user.first_name) %></h1>
  <p style="margin:0 0 12px;font-size:16px;line-height:1.5;"><%= t(".intro") %></p>
  <p style="margin:0 0 8px;font-size:16px;line-height:1.5;"><%= t(".#{@case}") %></p>
  <% if @case == :incomplete %>
    <ul style="margin:0 0 12px;padding-inline-start:20px;font-size:16px;line-height:1.6;">
      <% @missing.each do |item| %>
        <li><%= item %></li>
      <% end %>
    </ul>
    <p style="margin:0 0 12px;font-size:16px;line-height:1.5;"><%= t(".submit_note") %></p>
  <% end %>
  <p style="margin:16px 0;"><a href="<%= edit_teacher_profile_url(locale: I18n.locale) %>" style="display:inline-block;background:#0B5D4B;color:#FBF7EE;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:8px;font-size:15px;"><%= t(".button") %></a></p>
  <p style="margin:16px 0 0;font-size:14px;line-height:1.5;color:#555555;"><%= t(".footer") %></p>
</div>
