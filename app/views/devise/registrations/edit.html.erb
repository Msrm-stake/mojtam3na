<div class="login-page">
  <div class="login-card">
    <div class="login-card__header">
      <h1 class="login-card__title"><%= t("auth_pages.registrations.edit.title") %></h1>
      <p class="login-card__subtitle"><%= t("auth_pages.registrations.edit.subtitle") %></p>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name),
                        html: { method: :put, class: "login-form" }) do |f| %>
      <%= f.error_notification %>
      <%= f.input :email, required: false, label: t("auth_pages.fields.email"),
                  input_html: { autofocus: true, autocomplete: "email", inputmode: "email" } %>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="small text-muted"><%= resource.unconfirmed_email %></p>
      <% end %>

      <%= f.input :password, required: false, label: t("auth_pages.registrations.edit.password"),
                  hint: t("auth_pages.registrations.edit.password_hint"),
                  input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation, required: false,
                  label: t("auth_pages.registrations.edit.password_confirmation"),
                  input_html: { autocomplete: "new-password" } %>
      <%= f.input :current_password, required: false,
                  label: t("auth_pages.registrations.edit.current_password"),
                  hint: t("auth_pages.registrations.edit.current_password_hint"),
                  input_html: { autocomplete: "current-password" } %>
      <%= f.button :submit, t("auth_pages.registrations.edit.submit"), class: "btn btn-primary login-form__submit" %>
    <% end %>

    <div class="login-card__links">
      <span><%= t("auth_pages.registrations.edit.delete_text") %>
        <%= link_to t("auth_pages.registrations.edit.delete_link"), account_path %></span>
      <%= link_to t("auth_pages.registrations.edit.back"), account_path %>
    </div>
  </div>
</div>
