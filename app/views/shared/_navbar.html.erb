<nav class="navbar navbar-expand-lg navbar-mojtam3na">
  <div class="container">
    <%= link_to t(".brand"), root_path, class: "navbar-brand" %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="<%= t('.toggle') %>">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item"><%= link_to t(".find_teacher"), teachers_path, class: "nav-link" %></li>
        <li class="nav-item"><%= link_to t(".how_it_works"), "#how-it-works", class: "nav-link" %></li>
        <li class="nav-item"><%= link_to t(".become_teacher"), new_user_registration_path, class: "nav-link" %></li>
      </ul>

      <ul class="navbar-nav align-items-lg-center gap-lg-2">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-globe"></i> <%= locale_name(I18n.locale) %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <% I18n.available_locales.each do |locale| %>
              <li>
                <%= link_to locale_name(locale), url_for(locale: locale),
                      class: "dropdown-item #{'active' if locale == I18n.locale}" %>
              </li>
            <% end %>
          </ul>
        </li>

        <% if user_signed_in? %>
          <% if current_user.role_admin? %>
            <li class="nav-item"><%= link_to t(".admin"), admin_root_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to t(".payouts"), admin_payouts_path, class: "nav-link" %></li>
          <% end %>
          <% if current_user.role_teacher? %>
            <li class="nav-item"><%= link_to t(".my_profile"), edit_teacher_profile_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to t(".my_earnings"), earnings_path, class: "nav-link" %></li>
          <% end %>
          <% if current_user.role_parent? %>
            <li class="nav-item"><%= link_to t(".my_children"), students_path, class: "nav-link" %></li>
          <% end %>
          <% if current_user.role_parent? || current_user.role_teacher? %>
            <li class="nav-item"><%= link_to t(".my_lessons"), lessons_path, class: "nav-link" %></li>
          <% end %>
          <li class="nav-item">
            <%= link_to t(".log_out"), destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link" %>
          </li>
        <% else %>
          <li class="nav-item"><%= link_to t(".log_in"), new_user_session_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to t(".sign_up"), new_user_registration_path, class: "btn btn-primary" %></li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
