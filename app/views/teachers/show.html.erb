<% user = @profile.user %>

<div class="container auth-page">
  <p class="mb-3"><%= link_to t(".back"), teachers_path %></p>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="auth-card">
        <div class="profile-header">
          <%= teacher_portrait(@profile, size: :profile) %>
          <div>
            <h1 class="h3 mb-1"><%= public_name(user) %></h1>
            <p class="mb-0"><%= @profile.headline.presence || t("teachers.index.no_headline") %></p>
          </div>
        </div>

        <% if @profile.bio.present? %>
          <h2 class="h5 mt-4"><%= t(".about") %></h2>
          <%= simple_format(@profile.bio) %>
        <% end %>

        <%= render "availability", profile: @profile %>
        <h2 class="h5 mt-4"><%= t(".qualifications") %></h2>
        <ul class="qualification-list">
          <% @qualifications.each do |qualification| %>
            <li class="qualification-item">
              <div>
                <strong><%= qualification.title %></strong>
                <span class="badge text-bg-success"><%= t("qualifications.statuses.verified") %></span>
                <div class="small text-body-secondary">
                  <%= [t("qualifications.kinds.#{qualification.kind}"), qualification.institution, qualification.year_obtained].compact_blank.join(" · ") %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="auth-card">
        <div class="fs-4 fw-bold text-body">
          <%= teacher_price(@profile) %>
          <% unless @profile.hourly_rate_cents.zero? %>
            <span class="fs-6 fw-normal"><%= t(".per_hour") %></span>
          <% end %>
        </div>
        <%= link_to t(".book_trial"), new_teacher_lesson_path(@profile), class: "btn btn-gold w-100 mt-3" %>
        <% if lesson_payable?(@profile) %><%= link_to t(".book_lesson"), new_teacher_lesson_path(@profile, kind: "paid"), class: "btn btn-primary w-100 mt-2" %><% end %>

        <hr>

        <h3 class="h6"><%= t(".teaches_in") %></h3>
        <div class="chips">
          <% @profile.languages.each do |language| %>
            <span class="chip chip-gold"><%= language.native_name %></span>
          <% end %>
        </div>

        <h3 class="h6 mt-3"><%= t(".subjects") %></h3>
        <div class="chips">
          <% @profile.subjects.each do |subject| %>
            <span class="chip"><%= t("pages.home.subjects.items.#{subject.slug}", default: subject.name) %></span>
          <% end %>
        </div>

        <% if @profile.years_experience %>
          <p class="mt-3 mb-1"><%= t(".experience", years: @profile.years_experience) %></p>
        <% end %>
        <% if @profile.min_age && @profile.max_age %>
          <p class="mb-1"><%= t(".ages", min: @profile.min_age, max: @profile.max_age) %></p>
        <% end %>
        <% if @profile.intro_video_url.to_s.match?(%r{\Ahttps?://}i) %>
          <p class="mb-0 mt-2">
            <%= link_to t(".video"), @profile.intro_video_url, target: "_blank", rel: "noopener noreferrer" %>
          </p>
        <% end %>
      </div>
    </div>
  </div>
</div>
