<div class="container auth-page">
  <h1 class="h3 mb-1"><%= t(".title") %></h1>
  <p class="mb-4"><%= t(".intro") %></p>

  <%= form_with url: teachers_path, method: :get, class: "filter-bar" do %>
    <div>
      <label class="form-label" for="subject"><%= t(".subject") %></label>
      <%= select_tag :subject,
            options_for_select(@subjects.map { |s| [t("pages.home.subjects.items.#{s.slug}", default: s.name), s.id.to_s] }, params[:subject].to_s),
            include_blank: t(".any_subject"), class: "form-select" %>
    </div>
    <div>
      <label class="form-label" for="language"><%= t(".language") %></label>
      <%= select_tag :language,
            options_for_select(@languages.map { |l| [l.native_name, l.id.to_s] }, params[:language].to_s),
            include_blank: t(".any_language"), class: "form-select" %>
    </div>
    <div>
      <label class="form-label" for="sort"><%= t(".sort_by") %></label>
      <%= select_tag :sort,
            options_for_select(TeachersController::SORTS.map { |s| [t(".sorts.#{s}"), s] }, @sort),
            class: "form-select" %>
    </div>
    <div class="d-flex gap-2">
      <%= submit_tag t(".search"), name: nil, class: "btn btn-primary" %>
      <%= link_to t(".clear"), teachers_path, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>

  <p class="text-body-secondary"><%= t(".results", count: @profiles.size) %></p>

  <% if @profiles.empty? %>
    <div class="auth-card"><%= t(".empty") %></div>
  <% else %>
    <div class="row g-3">
      <% @profiles.each do |profile| %>
        <% subjects = profile.subjects.sort_by(&:id) %>
        <% languages = profile.languages.to_a %>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <%= link_to teacher_path(profile), class: "teacher-card teacher-card--compact" do %>
            <div class="tcard-head">
              <%= teacher_portrait(profile, size: :mini) %>
              <div class="tcard-id">
                <div class="teacher-name tcard-name"><%= public_name(profile.user) %></div>
                <% if profile.verified_teacher? %>
                  <span class="badge text-bg-success tcard-badge">✓ <%= t(".verified") %></span>
                <% end %>
              </div>
            </div>

            <div class="teacher-headline tcard-headline"><%= profile.headline.presence || t(".no_headline") %></div>

            <% if subjects.any? %>
              <div>
                <div class="tcard-label"><%= t(".teaches") %></div>
                <div class="tcard-chips">
                  <% subjects.first(2).each do |subject| %>
                    <span class="tcard-chip tcard-chip--subject"><%= t("pages.home.subjects.items.#{subject.slug}", default: subject.name) %></span>
                  <% end %>
                  <% if subjects.size > 2 %><span class="tcard-chip tcard-chip--more">+<%= subjects.size - 2 %></span><% end %>
                </div>
              </div>
            <% end %>

            <% if languages.any? %>
              <div>
                <div class="tcard-label"><%= t(".speaks") %></div>
                <div class="tcard-chips">
                  <% languages.first(2).each do |language| %>
                    <span class="tcard-chip tcard-chip--language"><%= language.native_name %></span>
                  <% end %>
                  <% if languages.size > 2 %><span class="tcard-chip tcard-chip--more">+<%= languages.size - 2 %></span><% end %>
                </div>
              </div>
            <% end %>

            <div class="tcard-foot">
              <div class="teacher-price tcard-price">
                <%= teacher_price(profile) %>
                <% unless profile.hourly_rate_cents.zero? %>
                  <span class="small fw-normal"><%= t(".per_hour") %></span>
                <% end %>
              </div>
              <% if profile.views_count.positive? %>
                <div class="teacher-views small text-body-secondary"><%= t(".views", count: profile.views_count) %></div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
