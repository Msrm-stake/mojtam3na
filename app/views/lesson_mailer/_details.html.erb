<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FBF7EE;border-radius:10px;margin:16px 0 20px;">
  <% lesson_detail_rows(@lesson, @role, @recipient).each do |label, value| %>
    <tr>
      <td style="padding:8px 16px;font-size:14px;color:#4F5E59;vertical-align:top;"><%= label %></td>
      <td style="padding:8px 16px;font-size:15px;font-weight:600;"><%= value %></td>
    </tr>
  <% end %>
</table>
