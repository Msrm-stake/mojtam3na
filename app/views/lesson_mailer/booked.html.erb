<% suffix = @lesson.trial? ? "" : "_paid" %>
<h1 style="font-size:22px;line-height:1.3;color:#0B5D4B;margin:0 0 12px;"><%= t(".heading#{suffix}.#{@role}") %></h1>
<p style="margin:0;font-size:16px;line-height:1.5;"><%= t(".intro#{suffix}.#{@role}", teacher: public_name(@teacher_user), child: @student.first_name) %></p>
<%= render "details" %>
<p style="margin:0 0 20px;font-size:14px;line-height:1.5;color:#4F5E59;"><%= t(".note#{suffix}", hours: (Lesson::CANCEL_NOTICE / 1.hour).to_i) %></p>
<%= render "button" %>
