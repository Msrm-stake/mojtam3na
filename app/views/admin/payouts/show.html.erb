<% user = @profile.user %>
<% badge = { "pending" => "warning", "paid" => "success", "cancelled" => "secondary" }[@payout.status] %>
<% recently_changed = @profile.payout_details_updated_at && @profile.payout_details_updated_at > 14.days.ago %>
<div class="container auth-page">
  <p class="mb-3"><%= link_to t(".back"), admin_payouts_path %></p>

  <div class="auth-card mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div>
        <h1 class="h3 mb-0"><%= user.full_name %></h1>
        <div class="text-body-secondary"><%= user.email %></div>
      </div>
      <span class="badge text-bg-<%= badge %>"><%= @payout.status.humanize %></span>
    </div>

    <% if recently_changed && @payout.status_pending? %>
      <div class="alert alert-warning mt-3 mb-0">
        <%= t(".changed_warning", date: l(@profile.payout_details_updated_at.to_date, format: :long)) %>
      </div>
    <% end %>

    <dl class="row mt-4 mb-0">
      <dt class="col-sm-4"><%= t(".period") %></dt>
      <dd class="col-sm-8"><%= @payout.period_start.strftime("%B %Y") %></dd>

      <dt class="col-sm-4"><%= t(".amount") %></dt>
      <dd class="col-sm-8 fw-bold"><%= format_money(@payout.amount_cents, @payout.currency) %></dd>

      <dt class="col-sm-4"><%= t(".method") %></dt>
      <dd class="col-sm-8"><%= @profile.payout_method.present? ? t("earnings.methods.#{@profile.payout_method}") : t(".none") %></dd>

      <dt class="col-sm-4"><%= t(".details") %></dt>
      <dd class="col-sm-8"><pre class="mb-0" style="white-space: pre-wrap;"><%= @profile.payout_details.presence || t(".none") %></pre></dd>

      <% if @payout.reference.present? %>
        <dt class="col-sm-4"><%= t(".reference") %></dt>
        <dd class="col-sm-8"><%= @payout.reference %></dd>
      <% end %>
      <% if @payout.paid_at %>
        <dt class="col-sm-4"><%= t(".paid_at") %></dt>
        <dd class="col-sm-8 mb-0"><%= l(@payout.paid_at.to_date, format: :long) %></dd>
      <% end %>
    </dl>
  </div>

  <% if @payout.status_pending? %>
    <div class="auth-card mb-4">
      <h2 class="h5"><%= t(".mark_title") %></h2>
      <%= form_with url: mark_paid_admin_payout_path(@payout), method: :patch, class: "row g-2 align-items-end" do %>
        <div class="col-sm-8">
          <label class="form-label" for="reference"><%= t(".reference_label") %></label>
          <%= text_field_tag :reference, nil, required: true, maxlength: 200, class: "form-control" %>
        </div>
        <div class="col-sm-4"><%= submit_tag t(".mark"), class: "btn btn-primary w-100" %></div>
      <% end %>
      <%= button_to t(".cancel"), cancel_admin_payout_path(@payout), method: :patch,
            class: "btn btn-outline-danger btn-sm mt-3",
            form: { data: { turbo_confirm: t(".cancel_confirm") } } %>
    </div>
  <% end %>

  <div class="auth-card">
    <h2 class="h5 mb-3"><%= t(".lessons") %></h2>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead><tr><th><%= t(".lesson_date") %></th><th><%= t(".amount") %></th></tr></thead>
        <tbody>
          <% @earnings.each do |earning| %>
            <tr>
              <td><%= l(earning.lesson.starts_at.to_date, format: :long) %></td>
              <td><%= format_money(earning.amount_cents, earning.currency) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
