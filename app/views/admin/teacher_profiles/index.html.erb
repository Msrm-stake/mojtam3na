<div class="container auth-page">
  <h1 class="h3 mb-3"><%= t(".title") %></h1>

  <% if @photos_waiting.any? %>
    <div class="alert alert-warning" role="status">
      <strong><%= t(".photos_waiting", count: @photos_waiting.size) %></strong>
      <ul class="mb-0">
        <% @photos_waiting.each do |profile| %>
          <li><%= link_to profile.user.full_name, admin_teacher_profile_path(profile) %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <ul class="nav nav-pills mb-4">
    <% TeacherProfile.statuses.each_key do |status| %>
      <li class="nav-item">
        <%= link_to admin_root_path(status: status), class: "nav-link #{'active' if status == @status}" do %>
          <%= t("admin.statuses.#{status}") %>
          <span class="badge text-bg-light"><%= @counts.fetch(status, 0) %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if @profiles.empty? %>
    <p class="text-body-secondary"><%= t(".empty") %></p>
  <% else %>
    <div class="auth-card p-0 overflow-hidden">
      <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th><%= t(".name") %></th>
            <th class="d-none d-md-table-cell"><%= t(".email") %></th>
            <th class="d-none d-md-table-cell"><%= t(".joined") %></th>
            <th class="d-none d-sm-table-cell"><%= t(".qualifications") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @profiles.each do |profile| %>
            <tr>
              <td>
                <%= link_to profile.user.full_name, admin_teacher_profile_path(profile), class: "fw-semibold text-decoration-none" %>
                <div class="small text-body-secondary d-md-none text-break"><%= profile.user.email %></div>
              </td>
              <td class="d-none d-md-table-cell text-break"><%= profile.user.email %></td>
              <td class="d-none d-md-table-cell"><%= l(profile.created_at.to_date) %></td>
              <td class="d-none d-sm-table-cell"><%= profile.qualifications.size %></td>
              <td class="text-end"><%= link_to t(".review"), admin_teacher_profile_path(profile), class: "btn btn-outline-primary btn-sm" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      </div>
    </div>
  <% end %>
</div>
