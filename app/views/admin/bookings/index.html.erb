<% zone = current_user.zone %>
<div class="container auth-page">
  <h1 class="h3 mb-1"><%= t(".title") %></h1>
  <p class="mb-4"><%= t(".intro", zone: zone.name) %></p>

  <div class="row g-3 mb-4">
    <div class="col-6 col-md-4"><div class="auth-card py-3"><div class="small text-body-secondary"><%= t(".total_views") %></div><div class="h3 mb-0"><%= @total_views %></div></div></div>
    <div class="col-6 col-md-4"><div class="auth-card py-3"><div class="small text-body-secondary"><%= t(".total_trials") %></div><div class="h3 mb-0"><%= @total_trials %></div></div></div>
    <div class="col-6 col-md-4"><div class="auth-card py-3"><div class="small text-body-secondary"><%= t(".total_paid") %></div><div class="h3 mb-0"><%= @total_paid %></div></div></div>
  </div>

  <h2 class="h5"><%= t(".per_teacher") %></h2>
  <div class="table-responsive mb-4">
    <table class="table table-sm align-middle">
      <thead>
        <tr>
          <th><%= t(".teacher") %></th>
          <th class="text-end"><%= t(".views") %></th>
          <th class="text-end"><%= t(".trials") %></th>
          <th class="text-end"><%= t(".paid") %></th>
          <th><%= t(".last_booking") %></th>
        </tr>
      </thead>
      <tbody>
        <% if @rows.empty? %>
          <tr><td colspan="5" class="text-body-secondary"><%= t(".no_teachers") %></td></tr>
        <% end %>
        <% @rows.each do |row| %>
          <tr>
            <td><%= link_to public_name(row[:profile].user), admin_teacher_profile_path(row[:profile]) %></td>
            <td class="text-end"><%= row[:views] %></td>
            <td class="text-end"><%= row[:trials] %></td>
            <td class="text-end"><%= row[:paid] %></td>
            <td>
              <% if row[:last] %>
                <%= row[:last].in_time_zone(zone).strftime("%a %d %b %Y, %H:%M") %>
              <% else %>
                <span class="text-body-secondary"><%= t(".none_yet") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <h2 class="h5"><%= t(".bookings") %></h2>
  <%= form_with url: admin_bookings_path, method: :get, class: "filter-bar" do %>
    <div>
      <label class="form-label" for="status"><%= t(".status") %></label>
      <%= select_tag :status, options_for_select(Admin::BookingsController::STATUSES.map { |s| [t(".statuses.#{s}"), s] }, @status), class: "form-select" %>
    </div>
    <div>
      <label class="form-label" for="kind"><%= t(".kind") %></label>
      <%= select_tag :kind, options_for_select(Admin::BookingsController::KINDS.map { |k| [t(".kinds.#{k}"), k] }, @kind), class: "form-select" %>
    </div>
    <div>
      <label class="form-label" for="teacher"><%= t(".teacher") %></label>
      <%= select_tag :teacher,
            options_for_select(@teachers.map { |profile| [public_name(profile.user), profile.id.to_s] }, @teacher_id.to_s),
            include_blank: t(".all_teachers"), class: "form-select" %>
    </div>
    <div class="d-flex gap-2">
      <%= submit_tag t(".filter"), name: nil, class: "btn btn-primary" %>
      <%= link_to t(".clear"), admin_bookings_path, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>

  <% if @lessons.empty? %>
    <div class="auth-card"><%= t(".empty") %></div>
  <% else %>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th><%= t(".booked_on") %></th>
            <th><%= t(".lesson_date") %></th>
            <th><%= t(".type") %></th>
            <th><%= t(".teacher") %></th>
            <th><%= t(".parent") %></th>
            <th><%= t(".child") %></th>
            <th><%= t(".status") %></th>
          </tr>
        </thead>
        <tbody>
          <% @lessons.each do |lesson| %>
            <% parent = lesson.booked_by %>
            <% child = lesson.student %>
            <% parent_name = [parent.first_name, parent.last_name].compact_blank.join(" ") %>
            <% child_name = [child.try(:first_name), child.try(:last_name)].compact_blank.join(" ").presence || child.try(:name) %>
            <% badge = { "scheduled" => "primary", "completed" => "success", "cancelled" => "secondary" }[lesson.status] || "light" %>
            <tr>
              <td class="text-nowrap"><%= lesson.created_at.in_time_zone(zone).strftime("%a %d %b %Y, %H:%M") %></td>
              <td class="text-nowrap"><strong><%= lesson.starts_at.in_time_zone(zone).strftime("%a %d %b %Y, %H:%M") %></strong></td>
              <td>
                <% if lesson.trial? %>
                  <span class="badge text-bg-warning"><%= t(".kinds.trial") %></span>
                <% else %>
                  <span class="badge text-bg-success"><%= t(".kinds.paid") %></span>
                  <div class="small"><%= format("%.2f", lesson.price_cents / 100.0) %> <%= lesson.currency %></div>
                <% end %>
              </td>
              <td><%= link_to public_name(lesson.teacher_profile.user), admin_teacher_profile_path(lesson.teacher_profile) %></td>
              <td>
                <%= parent_name.presence || "—" %>
                <div class="small"><%= mail_to parent.email %></div>
                <% if parent.respond_to?(:phone) && parent.phone.present? %><div class="small"><%= parent.phone %></div><% end %>
              </td>
              <td><%= child_name.presence || "—" %></td>
              <td>
                <span class="badge text-bg-<%= badge %>"><%= t(".statuses.#{lesson.status == 'scheduled' ? 'upcoming' : lesson.status}", default: lesson.status.humanize) %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="small text-body-secondary"><%= t(".limit_note") %></p>
  <% end %>
</div>
