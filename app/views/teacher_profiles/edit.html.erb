<div class="container auth-page">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="auth-card">
        <h1 class="h3 mb-2"><%= t(".title") %></h1>
        <p class="mb-4"><%= t(".intro") %></p>
        <%= link_to t(".availability_link"), availability_slots_path, class: "btn btn-outline-primary btn-sm mb-3" %>

        <% status_style = { "pending" => "warning", "approved" => "success", "rejected" => "danger", "suspended" => "secondary" }[@profile.status] %>
        <div class="alert alert-<%= status_style %>" role="status">
          <%= t(".statuses.#{@profile.status}") %>
          <% if @profile.status_rejected? && @profile.rejection_reason.present? %>
            <br><%= @profile.rejection_reason %>
          <% end %>
        </div>

        <% if flash[:profile_missing].present? %>
          <div class="alert alert-danger" role="alert" id="profile-missing">
            <strong><%= t(".missing_title") %></strong>
            <ul class="mb-0 mt-2">
              <% flash[:profile_missing].each do |item| %>
                <li><%= item %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= simple_form_for @profile, url: teacher_profile_path, method: :patch, html: { id: "teacher-profile-form" } do |f| %>
          <%= f.error_notification %>

          <h2 class="h5 mt-4"><%= t(".section_about") %></h2>

          <div class="tphoto-section" data-controller="photo-resize"
               data-photo-resize-type-error-value="<%= t(".photo.type_error") %>">
            <div class="tphoto-section__preview" data-photo-resize-target="preview">
              <%= teacher_portrait(@profile, size: :form) %>
            </div>
            <div class="tphoto-section__body">
              <h3 class="h6"><%= t(".photo.title") %></h3>
              <p class="small mb-2"><%= t(".photo.intro") %></p>
              <% if @profile.pending_photo.attached? && @profile.pending_photo.blob.persisted? %>
                <div class="alert alert-info small py-2 d-flex align-items-center gap-3" role="status">
                  <%= image_tag pending_teacher_photo_path(@profile, v: @profile.pending_photo.blob.id), alt: "", width: 56, height: 56,
                        class: "tphoto-review tphoto-review--small" %>
                  <span><%= t(".photo.waiting") %></span>
                </div>
              <% elsif @profile.photo_rejected_at.present? %>
                <div class="alert alert-warning small py-2" role="status"><%= t(".photo.rejected") %></div>
              <% end %>
              <%= f.input :pending_photo, as: :file, required: false, label: t(".photo.upload"), hint: t(".photo.hint"),
                    input_html: { accept: "image/jpeg,image/png",
                                  data: { photo_resize_target: "input", action: "change->photo-resize#resize" } } %>
              <p class="small text-danger mb-0" data-photo-resize-target="error" hidden></p>
            </div>
          </div>

          <fieldset class="tphoto-gender">
            <legend class="tphoto-gender__legend"><%= t(".photo.avatar_title") %></legend>
            <p class="small"><%= t(".photo.avatar_intro") %></p>
            <div class="tphoto-gender__choices">
              <% %w[female male].each do |kind| %>
                <label class="tphoto-choice">
                  <%= f.radio_button :gender, kind, class: "tphoto-choice__input" %>
                  <span class="tphoto-choice__card">
                    <span class="tphoto tphoto--choice tphoto--avatar"><%= render "teacher_profiles/avatar", kind: kind %></span>
                    <span class="tphoto-choice__label"><%= t("teacher_profiles.genders.#{kind}") %></span>
                  </span>
                </label>
              <% end %>
            </div>
          </fieldset>

          <%= f.input :headline, required: false, hint: t("teacher_setup.steps.headline.hint"),
                input_html: { maxlength: TeacherProfile::HEADLINE_MAX } %>
          <%= f.input :bio, as: :text, required: false, input_html: { rows: 6 } %>
          <div class="row">
            <div class="col-sm-6">
              <%= f.input :years_experience, as: :integer, required: false, input_html: { min: 0 } %>
            </div>
          </div>
          <%= f.input :intro_video_url, as: :url, required: false %>

          <h2 class="h5 mt-4"><%= t(".section_teaching") %></h2>
          <div class="row">
            <div class="col-sm-6">
              <%= f.input :hourly_rate, as: :decimal, required: false, hint: t(".rate_hint"),
                    input_html: { min: 0, step: "0.50", value: format("%.2f", @profile.hourly_rate) } %>
            </div>
            <div class="col-sm-6">
              <%= f.input :currency, collection: TeacherProfile::CURRENCIES, include_blank: false %>
            </div>
          </div>
          <div class="row">
            <div class="col-sm-6"><%= f.input :min_age, as: :integer, required: false, input_html: { min: 3, max: 18 } %></div>
            <div class="col-sm-6"><%= f.input :max_age, as: :integer, required: false, input_html: { min: 3, max: 18 } %></div>
          </div>

          <%= f.association :languages, as: :check_boxes, required: false,
                collection: Language.alphabetical, label_method: :native_name, value_method: :id %>
          <%= f.association :subjects, as: :check_boxes, required: false,
                collection: Subject.order(:id),
                label_method: ->(subject) { t("pages.home.subjects.items.#{subject.slug}") },
                value_method: :id %>

          <%= f.button :submit, t(".submit"), class: "btn btn-primary mt-3" %>
          <p class="small text-body-secondary mt-2 mb-0"><%= t(".save_hint") %></p>
        <% end %>

        <hr class="my-4">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
          <h2 class="h5 mb-0"><%= t(".qualifications.title") %></h2>
          <%= link_to t(".qualifications.add"), new_qualification_path, class: "btn btn-outline-primary btn-sm" %>
        </div>
        <p class="mt-2 mb-0"><%= t(".qualifications.intro") %></p>

        <% qualifications = @profile.qualifications.with_attached_document.order(:created_at) %>
        <% if qualifications.empty? %>
          <p class="text-body-secondary mt-3 mb-0"><%= t(".qualifications.empty") %></p>
        <% else %>
          <ul class="qualification-list">
            <% qualifications.each do |qualification| %>
              <% badge = { "pending" => "warning", "verified" => "success", "rejected" => "danger" }[qualification.status] %>
              <li class="qualification-item">
                <div>
                  <strong><%= qualification.title %></strong>
                  <span class="badge text-bg-<%= badge %>"><%= t("qualifications.statuses.#{qualification.status}") %></span>
                  <div class="small text-body-secondary">
                    <%= [t("qualifications.kinds.#{qualification.kind}"), qualification.institution, qualification.year_obtained].compact_blank.join(" · ") %>
                  </div>
                  <% if qualification.document.attached? %>
                    <%= link_to t(".qualifications.view"), qualification_document_path(qualification),
                          target: "_blank", rel: "noopener", class: "small" %>
                  <% end %>
                </div>
                <% unless qualification.status_verified? %>
                  <%= button_to t(".qualifications.delete"), qualification_path(qualification), method: :delete,
                        class: "btn btn-outline-danger btn-sm",
                        form: { data: { turbo_confirm: t(".qualifications.confirm") } } %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>

        <hr class="my-4">
        <h2 class="h5"><%= t(".submit_review.title") %></h2>
        <% if @profile.status_approved? %>
          <p class="mb-0 text-success"><%= t(".submit_review.approved") %></p>
        <% elsif @profile.status_suspended? %>
          <p class="mb-0"><%= t(".submit_review.suspended") %></p>
        <% elsif @profile.submitted? && !@profile.status_rejected? %>
          <p class="mb-0"><%= t(".submit_review.waiting") %></p>
        <% else %>
          <% if @profile.status_rejected? && @profile.rejection_reason.present? %>
            <div class="alert alert-warning"><%= t(".submit_review.rejected", reason: @profile.rejection_reason) %></div>
          <% end %>
          <p><%= t(".submit_review.intro") %></p>
          <button type="submit" form="teacher-profile-form" name="submit_for_review" value="1" class="btn btn-primary"><%= t(".submit_review.button") %></button>
          <p class="small text-body-secondary mt-2 mb-0"><%= t(".submit_hint") %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
