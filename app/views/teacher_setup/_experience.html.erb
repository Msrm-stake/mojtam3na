<h1 class="h4" id="tsetup-title"><%= t("teacher_setup.steps.experience.title") %></h1>
<p><%= t("teacher_setup.steps.experience.intro") %></p>
<%= form_with url: teacher_setup_path, method: :patch do %>
  <%= hidden_field_tag :step, "experience" %>
  <label class="form-label" for="teacher_profile_years_experience"><%= t("teacher_setup.steps.experience.label") %></label>
  <%= number_field_tag "teacher_profile[years_experience]",
        params.dig(:teacher_profile, :years_experience) || @profile.years_experience,
        id: "teacher_profile_years_experience", class: "form-control", min: 0, max: 60, step: 1, autofocus: true %>
  <%= render "teacher_setup/nav" %>
<% end %>
