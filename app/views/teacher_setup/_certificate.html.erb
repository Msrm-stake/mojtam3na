<h1 class="h4" id="tsetup-title"><%= t("teacher_setup.steps.certificate.title") %></h1>
<p><%= t("teacher_setup.steps.certificate.intro") %></p>
<div class="alert alert-info"><%= t("teacher_setup.steps.certificate.benefit") %></div>

<% if @profile.qualifications.exists? %>
  <p class="text-success"><%= t("teacher_setup.steps.certificate.have") %></p>
  <%= form_with url: teacher_setup_path, method: :patch do %>
    <%= hidden_field_tag :step, "certificate" %>
    <%= render "teacher_setup/nav" %>
  <% end %>
<% else %>
  <%= link_to t("teacher_setup.steps.certificate.add"), new_qualification_path, class: "btn btn-outline-primary" %>
  <%= form_with url: teacher_setup_path, method: :patch do %>
    <%= hidden_field_tag :step, "certificate" %>
    <%= render "teacher_setup/nav", label: t("teacher_setup.steps.certificate.later") %>
  <% end %>
<% end %>
