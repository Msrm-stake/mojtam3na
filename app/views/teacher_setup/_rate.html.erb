<h1 class="h4" id="tsetup-title"><%= t("teacher_setup.steps.rate.title") %></h1>
<p><%= t("teacher_setup.steps.rate.intro") %></p>
<% rate_default = @profile.hourly_rate.to_f.positive? ? format("%.2f", @profile.hourly_rate) : nil %>
<%= form_with url: teacher_setup_path, method: :patch do %>
  <%= hidden_field_tag :step, "rate" %>

  <label class="form-label" for="teacher_profile_hourly_rate"><%= t("teacher_setup.steps.rate.rate") %></label>
  <%= number_field_tag "teacher_profile[hourly_rate]", params.dig(:teacher_profile, :hourly_rate) || rate_default,
        id: "teacher_profile_hourly_rate", class: "form-control mb-3", min: 0, step: "0.50", autofocus: true %>

  <div class="row">
    <div class="col-6">
      <label class="form-label" for="teacher_profile_min_age"><%= t("teacher_setup.steps.rate.youngest") %></label>
      <%= number_field_tag "teacher_profile[min_age]", params.dig(:teacher_profile, :min_age) || @profile.min_age,
            id: "teacher_profile_min_age", class: "form-control", min: 3, max: 18, step: 1 %>
    </div>
    <div class="col-6">
      <label class="form-label" for="teacher_profile_max_age"><%= t("teacher_setup.steps.rate.oldest") %></label>
      <%= number_field_tag "teacher_profile[max_age]", params.dig(:teacher_profile, :max_age) || @profile.max_age,
            id: "teacher_profile_max_age", class: "form-control", min: 3, max: 18, step: 1 %>
    </div>
  </div>
  <%= render "teacher_setup/nav" %>
<% end %>
