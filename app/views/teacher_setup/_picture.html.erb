<h1 class="h4" id="tsetup-title"><%= t("teacher_setup.steps.picture.title") %></h1>
<p><%= t("teacher_setup.steps.picture.intro") %></p>

<%= form_with model: @profile, url: teacher_setup_path, method: :patch, multipart: true do |f| %>
  <%= hidden_field_tag :step, "picture" %>

  <div class="tphoto-section" data-controller="photo-resize"
       data-photo-resize-type-error-value="<%= t("teacher_profiles.edit.photo.type_error") %>">
    <div class="tphoto-section__preview" data-photo-resize-target="preview">
      <%= teacher_portrait(@profile, size: :form) %>
    </div>
    <div class="tphoto-section__body">
      <p class="small mb-2"><%= t("teacher_setup.steps.picture.upload") %></p>
      <%= f.file_field :pending_photo, accept: "image/jpeg,image/png", class: "form-control",
            data: { photo_resize_target: "input", action: "change->photo-resize#resize" } %>
      <p class="small text-danger mb-0" data-photo-resize-target="error" hidden></p>
    </div>
  </div>

  <fieldset class="tphoto-gender">
    <legend class="tphoto-gender__legend"><%= t("teacher_setup.steps.picture.avatar") %></legend>
    <div class="tphoto-gender__choices">
      <% %w[female male].each do |kind| %>
        <label class="tphoto-choice">
          <%= f.radio_button :gender, kind, class: "tphoto-choice__input" %>
          <span class="tphoto-choice__card">
            <span class="tphoto tphoto--choice tphoto--avatar"><%= render "teacher_profiles/avatar", kind: kind %></span>
            <span class="tphoto-choice__label"><%= t("teacher_profiles.genders.#{kind}") %></span>
          </span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <%= render "teacher_setup/nav" %>
<% end %>
