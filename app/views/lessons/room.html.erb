<div class="container auth-page">
  <p class="mb-3"><%= link_to t(".back"), lessons_path %></p>

  <h1 class="h4 mb-1">
    <% if current_user.id == @lesson.teacher_profile.user_id %>
      <%= t(".title_teacher", child: @lesson.student.first_name) %>
    <% else %>
      <%= t(".title_parent", teacher: public_name(@lesson.teacher_profile.user)) %>
    <% end %>
  </h1>
  <p class="text-body-secondary"><%= format_lesson_time(@lesson.starts_at, current_user.zone) %></p>

  <iframe class="video-frame" src="<%= @join_url %>"
          allow="camera; microphone; fullscreen; speaker; display-capture; autoplay"
          title="<%= t('.title_teacher', child: @lesson.student.first_name) if false %>Video"></iframe>

  <p class="mt-3 mb-1"><%= t(".tips") %></p>
  <p class="mb-1"><%= t(".parent_note") %></p>
  <p class="small text-body-secondary"><%= t(".problem") %></p>
</div>
