<%= render layout: "legal/frame", locals: { title: t("legal.notice.title") } do %>
  <h2>Publisher</h2>
  <p><%= legal(:company_name) %> &middot; <%= legal(:legal_form) %><br>
  <%= legal(:address) %><br>
  Registration number: <%= legal(:registration_number) %><br>
  VAT: <%= legal(:vat_number) %><br>
  Email: <%= legal(:contact_email) %></p>

  <h2>Publication director</h2>
