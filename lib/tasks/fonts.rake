namespace :fonts do
  desc "Copy Nunito and Cairo from node_modules into app/assets/fonts and generate the @font-face rules (no external font servers)"
  task install: :environment do
    require "fileutils"

    # Only the letter sets the site needs: Latin and Cyrillic for Nunito, Arabic for Cairo.
    packages = {
      "nunito" => %w[latin latin-ext cyrillic cyrillic-ext],
      "cairo" => %w[arabic latin latin-ext]
    }
    target = Rails.root.join("app/assets/fonts")
    FileUtils.mkdir_p(target)
    rules = []

    packages.each do |name, subsets|
      package = Rails.root.join("node_modules/@fontsource-variable/#{name}")
      css_path = package.join("index.css")
      abort "#{css_path} not found. Run: npm install --save-dev @fontsource-variable/#{name}" unless css_path.exist?

      css_path.read.scan(/@font-face\s*\{.*?\}/m).each do |block|
        file = block[%r{url\(\./files/([^)]+\.woff2)\)}, 1]
        next unless file

        subset = file.sub("#{name}-", "").sub(/-wght-normal\.woff2\z/, "")
        next unless subsets.include?(subset)

        FileUtils.cp(package.join("files", file), target.join(file))
        rule = block.gsub(%r{,\s*url\(\./files/[^)]+\.woff\)\s*format\(["']woff["']\)}, "")
        rules << rule.gsub(%r{url\(\./files/([^)]+)\)}) { "font-url(\"#{Regexp.last_match(1)}\")" }
      end
    end
    abort "No font rules were generated." if rules.empty?

    header = "// Generated by bin/rails fonts:install from @fontsource-variable (SIL Open Font License). Do not edit.\n"
    File.write(Rails.root.join("app/assets/stylesheets/config/_font_faces.scss"), header + rules.join("\n\n") + "\n")
    puts "Font files copied: #{Dir[target.join('*.woff2')].size}, @font-face rules: #{rules.size}"
  end
end
